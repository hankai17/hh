long hh_main_transit(std::vector<long> &ret_stack, long u, long c)
{
   long v = -1;
again:
   switch (u) {
  case 0:
    switch (c) {
    case 105:
      v = 2;
      break;
    }
    break;
  case 1:
    switch (c) {
    case 48 ... 57:
      v = 1;
      break;
    default:
      if (ret_stack.size()) { u = ret_stack.back(); ret_stack.pop_back(); goto again; }
      break;
    }
    break;
  case 2:
    switch (c) {
    case 100:
      v = 3;
      break;
    }
    break;
  case 3:
    switch (c) {
    case 58:
      v = 4;
      break;
    }
    break;
   case 4:                          // [4]: <1, 5>
       u = 1;
   ret_stack.push_back(5);
   goto again;
  }
  return v;
}
