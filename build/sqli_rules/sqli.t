import "sql_lexer.t"
import "sql_parser.t"


////////////////////////////////////////////////////////////////////////////////
// Common
////////////////////////////////////////////////////////////////////////////////

sqli_ws = [ \t\r\n]+
sqli_opt_ws = [ \t\r\n]*


////////////////////////////////////////////////////////////////////////////////
// 1. Boolean-based SQL Injection
//
// Examples:
//
//   1 OR 1=1
//   1 AND 1=1
//   'a'='a' OR 'b'='b'
//   1=1 AND 2=2
//
// 注意：这里只检测“SQL expression + boolean operator + SQL expression”
// 不直接判断真假，避免把完整 SQL expression evaluator 做进 grammar。
////////////////////////////////////////////////////////////////////////////////

export sqli_boolean =
      expr_comparison sqli_ws OR_ sqli_ws expr_comparison
    | expr_comparison sqli_ws AND_ sqli_ws expr_comparison



////////////////////////////////////////////////////////////////////////////////
// 2. UNION SQL Injection
//
// Examples:
//
//   UNION SELECT
//   UNION ALL SELECT
//   UNION SELECT 1
//   UNION SELECT 1,2,3
////////////////////////////////////////////////////////////////////////////////

sqli_union_select =
      UNION_ sqli_ws SELECT_
    | UNION_ sqli_ws ALL_ sqli_ws SELECT_

export sqli_union =
      sqli_union_select
    | sqli_union_select sqli_ws expr_list


////////////////////////////////////////////////////////////////////////////////
// 3. Subquery Injection
//
// Examples:
//
//   (SELECT ...)
//   EXISTS (SELECT ...)
//   NOT EXISTS (SELECT ...)
////////////////////////////////////////////////////////////////////////////////

export sqli_subquery =
      OPEN_PAR opt_ws !select_stmt opt_ws CLOSE_PAR
    | EXISTS_ ws OPEN_PAR opt_ws !select_stmt opt_ws CLOSE_PAR
    | NOT_ ws EXISTS_ ws OPEN_PAR opt_ws !select_stmt opt_ws CLOSE_PAR


////////////////////////////////////////////////////////////////////////////////
// 4. String Concatenation
//
// SQLite:
//
//   'a' || 'b'
//
// Also supports the expression grammar already present in sql_parser.t.
//
// 注意：|| 本身是合法 SQL，因此这是“结构规则”，不建议单独作为高置信度
// block 规则。
////////////////////////////////////////////////////////////////////////////////

export sqli_string_concat =
    expr_unary opt_ws PIPE2 opt_ws expr_unary


////////////////////////////////////////////////////////////////////////////////
// 5. Numeric Expression / Boolean Numeric Expression
//
// Examples:
//
//   1+1=2
//   1*2=2
//   10-1=9
//   4/2=2
//
// 同样只检测结构，不做常量求值。
////////////////////////////////////////////////////////////////////////////////

export sqli_numeric =
      expr_addition sqli_ws compare_operator sqli_ws expr_addition


////////////////////////////////////////////////////////////////////////////////
// 6. Stacked Query
//
// Examples:
//
//   ;SELECT ...
//   ;UPDATE ...
//   ;DELETE ...
//   ;INSERT ...
//   ;DROP ...
//   ;ALTER ...
//   ;CREATE ...
//
// 不单独检测 ';'，降低误报。
////////////////////////////////////////////////////////////////////////////////

export sqli_stacked =
    SCOL sqli_opt_ws (
          SELECT_
        | INSERT_
        | UPDATE_
        | DELETE_
        | DROP_
        | ALTER_
        | CREATE_
    )


////////////////////////////////////////////////////////////////////////////////
// 7. ORDER BY Injection
//
// Examples:
//
//   ORDER BY 1
//   ORDER BY 2
//   ORDER BY column
//   ORDER BY column DESC
////////////////////////////////////////////////////////////////////////////////

export sqli_order_by =
    ORDER_ ws BY_ ws expr_comparison

export sqli_order_by_direction =
    ORDER_ ws BY_ ws expr_comparison sqli_ws (ASC_ | DESC_)


////////////////////////////////////////////////////////////////////////////////
// 8. LIMIT Injection
//
// Examples:
//
//   LIMIT 1
//   LIMIT 1 OFFSET 2
//
// 注意：LIMIT 本身是合法 SQL，所以这是 fragment rule。
////////////////////////////////////////////////////////////////////////////////

export sqli_limit =
    LIMIT_ ws expr_comparison

export sqli_limit_offset =
    LIMIT_ ws expr_comparison ws OFFSET_ ws expr_comparison


////////////////////////////////////////////////////////////////////////////////
// 9. INSERT Injection
//
// Examples:
//
//   INSERT INTO users VALUES (...)
//   INSERT INTO users (...) VALUES (...)
//
// 这里只做 fragment，不构造完整 INSERT grammar。
////////////////////////////////////////////////////////////////////////////////

export sqli_insert =
    INSERT_ ws INTO_ ws any_name

export sqli_insert_values =
    INSERT_ ws INTO_ ws any_name ws VALUES_ ws OPEN_PAR opt_ws expr_list opt_ws CLOSE_PAR


////////////////////////////////////////////////////////////////////////////////
// 10. UPDATE Injection
//
// Examples:
//
//   UPDATE users SET name='x'
//   UPDATE users SET id=1
////////////////////////////////////////////////////////////////////////////////

export sqli_update =
    UPDATE_ ws any_name ws SET_ ws any_name opt_ws ASSIGN opt_ws expr_comparison


////////////////////////////////////////////////////////////////////////////////
// 11. DELETE Injection
//
// DELETE is useful together with stacked-query detection and SQL fragments.
////////////////////////////////////////////////////////////////////////////////

export sqli_delete =
    DELETE_ ws FROM_ ws any_name


////////////////////////////////////////////////////////////////////////////////
// 12. SELECT Injection Fragment
//
// 不要求完整 SQL。
//
// Examples:
//
//   SELECT 1
//   SELECT 1,2,3
//   SELECT username
////////////////////////////////////////////////////////////////////////////////

export sqli_select =
    SELECT_ ws expr_list


////////////////////////////////////////////////////////////////////////////////
// 13. SELECT + FROM Fragment
////////////////////////////////////////////////////////////////////////////////

export sqli_select_from =
    SELECT_ ws expr_list ws FROM_ ws any_name


////////////////////////////////////////////////////////////////////////////////
// 14. EXISTS Injection
//
// Examples:
//
//   EXISTS (SELECT ...)
//   NOT EXISTS (SELECT ...)
////////////////////////////////////////////////////////////////////////////////

export sqli_exists =
      EXISTS_ ws OPEN_PAR opt_ws !select_stmt opt_ws CLOSE_PAR
    | NOT_ ws EXISTS_ ws OPEN_PAR opt_ws !select_stmt opt_ws CLOSE_PAR


////////////////////////////////////////////////////////////////////////////////
// 15. LIKE Injection
//
// Examples:
//
//   'a' LIKE 'a'
//   1 LIKE 1
////////////////////////////////////////////////////////////////////////////////

export sqli_like =
    expr_comparison ws (LIKE_ | NOT_ ws LIKE_) ws expr_comparison


////////////////////////////////////////////////////////////////////////////////
// 16. BETWEEN Injection
////////////////////////////////////////////////////////////////////////////////

export sqli_between =
    expr_comparison ws (NOT_ ws)? BETWEEN_ ws expr_comparison ws AND_ ws expr_comparison


////////////////////////////////////////////////////////////////////////////////
// 17. IN Injection
//
// Examples:
//
//   1 IN (1,2,3)
//   1 IN (SELECT ...)
////////////////////////////////////////////////////////////////////////////////

export sqli_in =
    expr_comparison ws (NOT_ ws)? IN_ ws OPEN_PAR opt_ws ( expr_list | !select_stmt)?  opt_ws CLOSE_PAR

