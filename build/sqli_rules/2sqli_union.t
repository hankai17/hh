import "sql_lexer.t"
import "sql_parser.t"


////////////////////////////////////////////////////////////////////////////////
// Common
////////////////////////////////////////////////////////////////////////////////

sqli_ws = [ \t\r\n]+
sqli_opt_ws = [ \t\r\n]*



////////////////////////////////////////////////////////////////////////////////
// 2. UNION SQL Injection
//
// Examples:
//
//   UNION SELECT
//   UNION ALL SELECT
//   UNION SELECT 1
//   UNION SELECT 1,2,3
////////////////////////////////////////////////////////////////////////////////

sqli_union_select =
      UNION_ sqli_ws SELECT_
    | UNION_ sqli_ws ALL_ sqli_ws SELECT_

export sqli_union =
      sqli_union_select
    | sqli_union_select sqli_ws expr_list

