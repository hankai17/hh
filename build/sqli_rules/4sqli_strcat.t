import "sql_lexer.t"
import "sql_parser.t"


////////////////////////////////////////////////////////////////////////////////
// Common
////////////////////////////////////////////////////////////////////////////////

sqli_ws = [ \t\r\n]+
sqli_opt_ws = [ \t\r\n]*


////////////////////////////////////////////////////////////////////////////////
// 4. String Concatenation
//
// SQLite:
//
//   'a' || 'b'
//
// Also supports the expression grammar already present in sql_parser.t.
//
// 注意：|| 本身是合法 SQL，因此这是“结构规则”，不建议单独作为高置信度
// block 规则。
////////////////////////////////////////////////////////////////////////////////

export sqli_string_concat =
    expr_unary opt_ws PIPE2 opt_ws expr_unary

