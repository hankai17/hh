
import "sql_lexer.t"
import "sql_parser.t"


////////////////////////////////////////////////////////////////////////////////
// Common
////////////////////////////////////////////////////////////////////////////////

sqli_ws = [ \t\r\n]+
sqli_opt_ws = [ \t\r\n]*

////////////////////////////////////////////////////////////////////////////////
// 6. Stacked Query
//
// Examples:
//
//   ;SELECT ...
//   ;UPDATE ...
//   ;DELETE ...
//   ;INSERT ...
//   ;DROP ...
//   ;ALTER ...
//   ;CREATE ...
//
// 不单独检测 ';'，降低误报。
////////////////////////////////////////////////////////////////////////////////

export sqli_stacked =
    SCOL sqli_opt_ws (
          SELECT_
        | INSERT_
        | UPDATE_
        | DELETE_
        | DROP_
        | ALTER_
        | CREATE_
    )
