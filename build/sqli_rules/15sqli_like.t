sqli_ws = [ \t\r\n]+
sqli_opt_ws = [ \t\r\n]*


////////////////////////////////////////////////////////////////////////////////
// 15. LIKE Injection
//
// Examples:
//
//   'a' LIKE 'a'
//   1 LIKE 1
////////////////////////////////////////////////////////////////////////////////

export sqli_like =
    expr_comparison ws (LIKE_ | NOT_ ws LIKE_) ws expr_comparison

