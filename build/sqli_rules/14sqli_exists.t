
import "sql_lexer.t"
import "sql_parser.t"


////////////////////////////////////////////////////////////////////////////////
// Common
////////////////////////////////////////////////////////////////////////////////

sqli_ws = [ \t\r\n]+
sqli_opt_ws = [ \t\r\n]*


////////////////////////////////////////////////////////////////////////////////
// 14. EXISTS Injection
//
// Examples:
//
//   EXISTS (SELECT ...)
//   NOT EXISTS (SELECT ...)
////////////////////////////////////////////////////////////////////////////////

export sqli_exists =
      EXISTS_ ws OPEN_PAR opt_ws !select_stmt opt_ws CLOSE_PAR
    | NOT_ ws EXISTS_ ws OPEN_PAR opt_ws !select_stmt opt_ws CLOSE_PAR


