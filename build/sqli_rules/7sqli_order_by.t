
import "sql_lexer.t"
import "sql_parser.t"


////////////////////////////////////////////////////////////////////////////////
// Common
////////////////////////////////////////////////////////////////////////////////

sqli_ws = [ \t\r\n]+
sqli_opt_ws = [ \t\r\n]*


////////////////////////////////////////////////////////////////////////////////
// 7. ORDER BY Injection
//
// Examples:
//
//   ORDER BY 1
//   ORDER BY 2
//   ORDER BY column
//   ORDER BY column DESC
////////////////////////////////////////////////////////////////////////////////

export sqli_order_by =
    ORDER_ ws BY_ ws expr_comparison

export sqli_order_by_direction =
    ORDER_ ws BY_ ws expr_comparison sqli_ws (ASC_ | DESC_)
