
import "sql_lexer.t"
import "sql_parser.t"


////////////////////////////////////////////////////////////////////////////////
// Common
////////////////////////////////////////////////////////////////////////////////

sqli_ws = [ \t\r\n]+
sqli_opt_ws = [ \t\r\n]*


////////////////////////////////////////////////////////////////////////////////
// 8. LIMIT Injection
//
// Examples:
//
//   LIMIT 1
//   LIMIT 1 OFFSET 2
//
// 注意：LIMIT 本身是合法 SQL，所以这是 fragment rule。
////////////////////////////////////////////////////////////////////////////////

export sqli_limit =
    LIMIT_ ws expr_comparison

export sqli_limit_offset =
    LIMIT_ ws expr_comparison ws OFFSET_ ws expr_comparison
